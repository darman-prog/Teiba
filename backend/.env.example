# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=teiba_db

# OpenCode Go. Nunca commitear la clave real.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
AGENT_MODEL=deepseek-v4.1-flash
AGENT_TEMPERATURE=0
AGENT_MAX_STEPS=6
AGENT_MAX_TOKENS=600
AGENT_TIMEOUT_SECONDS=30
AGENT_TOTAL_TIMEOUT_SECONDS=60

# Límites de la API
MAX_PREGUNTA_CHARS=500
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_CONCURRENT=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Demo
DEMO_CACHE_TTL_SECONDS=600
SIN_REPORTAR_MIN=60
LOG_LEVEL=INFO
TOOL_RESULT_MAX_CHARS=1500
