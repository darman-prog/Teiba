    {
      "name": "Agente",
      "item": [
        {
          "name": "Consulta principal",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set(\"requestId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Respuesta no vacía\", () => pm.expect(body.respuesta).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Trazas es array\", () => pm.expect(body.trazas).to.be.an(\"array\"));",
                  "pm.test(\"Meta completa\", () => pm.expect(body.meta).to.include.keys(\"modelo\", \"pasos\", \"duracion_ms\", \"cached\", \"trace_id\"));",
                  "pm.test(\"trace_id coincide\", () => pm.expect(body.meta.trace_id).to.eql(pm.variables.get(\"requestId\")));",
                  "pm.test(\"X-Trace-Id coincide\", () => pm.expect(pm.response.headers.get(\"X-Trace-Id\")).to.eql(pm.variables.get(\"requestId\")));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pregunta\": \"¿Cómo está el sensor de calidad del suelo del Sector Norte?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/agente/consulta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agente",
                "consulta"
              ]
            },
            "description": "Consulta de la demo. Debe responder por SS-01 y mostrar trazas de list_sensors, get_sensor_history y get_device_context. Requiere la key del LLM configurada en backend/.env."
          },
          "response": []
        },
        {
          "name": "Consulta antena",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set(\"requestId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Respuesta no vacía\", () => pm.expect(body.respuesta).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Trazas es array\", () => pm.expect(body.trazas).to.be.an(\"array\"));",
                  "pm.test(\"Usa get_devices_by_antenna\", () => {",
                  "  const tools = body.trazas.map((traza) => traza.tool);",
                  "  pm.expect(tools).to.include(\"get_devices_by_antenna\");",
                  "});",
                  "pm.test(\"trace_id coincide\", () => pm.expect(body.meta.trace_id).to.eql(pm.variables.get(\"requestId\")));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pregunta\": \"¿Qué sensores dependen de la antena ANT-01 y alguno está sin reportar?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/agente/consulta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agente",
                "consulta"
              ]
            },
            "description": "Consulta de la demo sobre la antena ANT-01. Debe identificar SS-02 como sin_reportar usando get_devices_by_antenna."
          },
          "response": []
        },
