{
  "info": {
    "_postman_id": "2b7f3f3e-5e2a-4c8b-9a6d-1f0e7c4b9a21",
    "name": "Teiba Sage API",
    "description": "Colección local de la API Teiba Sage.\n\nRequisitos:\n1. MongoDB con los datos de la entrega y el seed de demo.\n2. Backend en http://127.0.0.1:8000.\n3. La key del LLM configurada en backend/.env para las requests del agente.\n\nNo requiere autenticación. Importa también el environment Teiba Local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Mongo responde\", () => pm.expect(body.mongo.ok).to.eql(true));",
                  "pm.test(\"Base teiba_db\", () => pm.expect(body.mongo.db).to.eql(\"teiba_db\"));",
                  "pm.test(\"Version presente\", () => pm.expect(body.version).to.be.a(\"string\"));",
                  "pm.test(\"LLM configurado es boolean\", () => pm.expect(body.llm.configurado).to.be.a(\"boolean\"));",
                  "pm.test(\"X-Trace-Id presente\", () => pm.expect(pm.response.headers.get(\"X-Trace-Id\")).to.be.a(\"string\").and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Estado de MongoDB y del LLM. Devuelve 200 incluso si status es degraded: revisa mongo.ok y llm.configurado."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sensores",
      "item": [
        {
          "name": "Calidad del suelo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"items es array\", () => pm.expect(body.items).to.be.an(\"array\"));",
                  "pm.test(\"total coherente\", () => pm.expect(body.total).to.eql(body.items.length));",
                  "pm.test(\"estados válidos\", () => {",
                  "  const validos = [\"ok\", \"warning\", \"danger\", \"sin_datos\"];",
                  "  body.items.forEach((item) => pm.expect(validos).to.include(item.estado));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sensores?tipo=calidad_suelo&limite=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sensores"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "calidad_suelo"
                },
                {
                  "key": "limite",
                  "value": "5"
                }
              ]
            },
            "description": "Catálogo de sensores de suelo. Con el seed de demo: SS-01 danger por pH, SS-02 warning por antigüedad y SS-03 danger por batería."
          },
          "response": []
        },
